<ui:FluentWindow x:Class="OwaWidget.App.Views.FlyoutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="OWA Widget"
                 Width="440"
                 Height="640"
                 WindowStyle="None"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Acrylic"
                 ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RangeButton" TargetType="ui:Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,14,16,6">
            <StackPanel>
                <TextBlock Text="Корпоративная почта" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Text="Подключение…" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
            </StackPanel>
            <ui:Button Content="Открыть OWA"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Padding="10,4"
                       FontSize="12"
                       Click="OnOpenMail" />
        </Grid>

        <Grid Grid.Row="1" Margin="16,8,16,6">
            <TextBlock Text="ВСТРЕЧИ" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="RangeTodayButton" Content="Сегодня" Style="{StaticResource RangeButton}" Click="OnRangeToday" />
                <ui:Button x:Name="RangeThreeButton" Content="3 дня" Style="{StaticResource RangeButton}" Click="OnRangeThree" />
                <ui:Button x:Name="RangeWeekButton" Content="Неделя" Style="{StaticResource RangeButton}" Click="OnRangeWeek" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2"
                   x:Name="NoMeetingsText"
                   Text="На сегодня встреч больше нет"
                   FontSize="12"
                   Opacity="0.5"
                   Margin="18,2,16,10"
                   Visibility="Collapsed" />

        <ItemsControl Grid.Row="3" x:Name="MeetingsList" Margin="10,0,10,4" MaxHeight="230">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,7" Margin="0,1" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,10,0"
                                    Background="{Binding AccentBrush}" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <ui:Button Grid.Column="2"
                                       Content="Войти"
                                       FontSize="11"
                                       Padding="9,3"
                                       VerticalAlignment="Center"
                                       Appearance="Primary"
                                       Visibility="{Binding JoinVisibility}"
                                       Tag="{Binding Link}"
                                       Click="OnJoin" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ПОЧТА" Style="{StaticResource SectionHeader}" Margin="16,0,16,6" />

            <ItemsControl Grid.Row="1" x:Name="MailList" Margin="10,0,10,4">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,7" Margin="0,1" CornerRadius="6"
                                Background="{Binding RowBrush}"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnMailClick">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,6,9,0"
                                             VerticalAlignment="Top"
                                             Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                             Visibility="{Binding UnreadVisibility}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Sender}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subject}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        <TextBlock Text="{Binding Preview}" FontSize="11" Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                   Visibility="{Binding CollapsedVisibility}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="11" Opacity="0.55"
                                               VerticalAlignment="Top" Margin="8,0,0,0" />
                                </Grid>

                                <Border Visibility="{Binding ExpandedVisibility}"
                                        Margin="16,8,0,2"
                                        Padding="10,8"
                                        CornerRadius="6"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <StackPanel>
                                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding Body}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.85" />
                                        </ScrollViewer>
                                        <ui:Button Content="Открыть в OWA"
                                                   FontSize="11"
                                                   Padding="9,3"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Left"
                                                   Click="OnOpenMail" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <TextBlock Grid.Row="5" x:Name="FooterText" Text="" FontSize="11" Opacity="0.5" Margin="16,6,16,12" />
    </Grid>
</ui:FluentWindow>