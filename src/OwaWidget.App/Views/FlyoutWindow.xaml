<ui:FluentWindow x:Class="OwaWidget.App.Views.FlyoutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:OwaWidget.App.Views"
                 Title="Owl"
                 Width="430"
                 Height="720"
                 WindowStyle="None"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="#101217"
                 Foreground="#EEF1F7"
                 FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"
                 UseLayoutRounding="True"
                 TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#EEF1F7" />
        <SolidColorBrush x:Key="Muted" Color="#858C9D" />
        <SolidColorBrush x:Key="Dim" Color="#737B8B" />
        <SolidColorBrush x:Key="Faint" Color="#6F788A" />
        <SolidColorBrush x:Key="Hairline" Color="#17FFFFFF" />
        <SolidColorBrush x:Key="RowLine" Color="#0EFFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#71A9FF" />
        <SolidColorBrush x:Key="AccentSoft" Color="#79AEF9" />
        <SolidColorBrush x:Key="Panel" Color="#191C24" />
        <SolidColorBrush x:Key="Live" Color="#65D6A0" />
        <SolidColorBrush x:Key="TabActive" Color="#12FFFFFF" />

        <Geometry x:Key="CalendarIcon">M4,6 L20,6 L20,20 L4,20 Z M4,10 L20,10 M8.5,3.6 L8.5,7 M15.5,3.6 L15.5,7</Geometry>
        <Geometry x:Key="MailIcon">M3,6 L21,6 L21,18 L3,18 Z M3.6,6.8 L12,13.4 L20.4,6.8</Geometry>
        <Geometry x:Key="SearchIcon">M11,4.5 A6.5,6.5 0 1 1 10.99,4.5 Z M15.8,15.8 L20,20</Geometry>
        <Geometry x:Key="VideoIcon">M3,6 L15,6 L15,18 L3,18 Z M15,10.5 L21,7.5 L21,16.5 Z</Geometry>
        <Geometry x:Key="CheckIcon">M5,12.5 L9.5,17 L19,7</Geometry>
        <Geometry x:Key="ChevronRight">M9,5 L16,12 L9,19</Geometry>
        <Geometry x:Key="ChevronLeft">M14,5 L7,12 L14,19</Geometry>
        <Geometry x:Key="CloseIcon">M6,6 L18,18 M18,6 L6,18</Geometry>
        <Geometry x:Key="OwlIcon">M5,4.5 L7.4,7.2 M19,4.5 L16.6,7.2 M12,20 C7.8,20 5,17.1 5,12.8 C5,9 8,6.3 12,6.3 C16,6.3 19,9 19,12.8 C19,17.1 16.2,20 12,20 Z M9.3,9.9 A2.1,2.1 0 1 1 9.29,9.9 Z M14.7,9.9 A2.1,2.1 0 1 1 14.69,9.9 Z</Geometry>

        <Style x:Key="IconButton" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#12FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="9" />
            <Setter Property="MinWidth" Value="9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#2EFFFFFF" Margin="3,0,2,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
        </Style>

        <DataTemplate x:Key="SectionTemplate">
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,9">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
                            <TextBlock Text="{Binding DateLabel}" FontSize="12" Foreground="#777F90" Margin="7,2,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#70788B" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Pill}" FontSize="10" FontWeight="Bold" Foreground="{Binding PillBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <Border Grid.Row="1" Height="1" Background="{StaticResource Hairline}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EventTemplate">
            <StackPanel>
                <Border Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnRowClick" MinHeight="58">
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
                                Background="{Binding TileBrush}" HorizontalAlignment="Left">
                            <Path Data="{Binding Icon}" Stroke="{Binding AccentBrush}" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="14" Height="14" />
                        </Border>

                        <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="12" Foreground="#8890A0"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="{Binding TitleWeight}"
                                           Foreground="{Binding TitleBrush}" TextTrimming="CharacterEllipsis" />
                                <Ellipse Width="5" Height="5" Fill="#70AAFF" Margin="8,1,0,0"
                                         VerticalAlignment="Center" Visibility="{Binding UnreadVisibility}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource Dim}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Visibility="{Binding NeedsResponseVisibility}" Margin="7,0,0,0"
                                        CornerRadius="5" Padding="6,1" BorderThickness="1" BorderBrush="#4DEFB06C">
                                    <TextBlock Text="ждёт ответа" FontSize="9" FontWeight="SemiBold" Foreground="#EFB06C" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{Binding Meta}" FontSize="10.5" Foreground="{Binding MetaBrush}"
                                   FontWeight="{Binding MetaWeight}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Visibility="{Binding ExpandedVisibility}" Margin="72,0,0,10" Padding="12,10"
                        CornerRadius="10" Background="#14FFFFFF">
                    <StackPanel>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Body}" FontSize="12" TextWrapping="Wrap" Foreground="#B9C1CF" />
                        </ScrollViewer>
                        <TextBlock Text="Открыть в OWA" FontSize="11.5" Foreground="{StaticResource Accent}"
                                   Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonUp="OnOpenMail" />
                    </StackPanel>
                </Border>

                <Border Height="1" Background="{StaticResource RowLine}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#101217" TextElement.Foreground="#EEF1F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,14,16,10">
            <StackPanel Orientation="Horizontal">
                <Border Width="30" Height="30" CornerRadius="9">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#426EAE" Offset="0" />
                            <GradientStop Color="#1F3963" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Data="{StaticResource OwlIcon}" Stroke="#D7E6FF" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stretch="Uniform" Width="18" Height="18" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Owl" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
                    <TextBlock Text="companion" FontSize="11" Foreground="#737A8C" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource Live}" Margin="0,0,9,0"
                         VerticalAlignment="Center" ToolTip="{Binding}" />
                <Border Style="{StaticResource IconButton}" MouseLeftButtonUp="OnToggleSearch" ToolTip="Поиск">
                    <Path Data="{StaticResource SearchIcon}" Stroke="#8F96A6" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" Stretch="Uniform" Width="16" Height="16" />
                </Border>
                <Border Style="{StaticResource IconButton}" MouseLeftButtonUp="OnOpenMail" ToolTip="Открыть OWA">
                    <Path Data="{StaticResource ChevronRight}" Stroke="#8F96A6" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="15" Height="15" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" x:Name="NextUpCard" Margin="16,0,16,0" Padding="16,15,16,14" CornerRadius="13"
                BorderThickness="1" BorderBrush="#3874A8F1" Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                    <GradientStop Color="#B81F3F6A" Offset="0" />
                    <GradientStop Color="#EB191F2C" Offset="0.72" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Live}" VerticalAlignment="Center" />
                    <TextBlock x:Name="NextUpLabel" Text="СЛЕДУЮЩАЯ ВСТРЕЧА" FontSize="9" FontWeight="Bold"
                               Foreground="#9EC4FB" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                    <TextBlock x:Name="NextUpCountdown" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
                    <TextBlock x:Name="NextUpSpan" FontSize="11" Foreground="#94B9ED" Margin="8,0,0,5"
                               VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock x:Name="NextUpSubject" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Fg}"
                           Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NextUpMeta" FontSize="11" Foreground="#99A4B6" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
                <Border x:Name="NextUpJoin" CornerRadius="9" Padding="13,8" Margin="0,15,0,0"
                        HorizontalAlignment="Right" Cursor="Hand" BorderThickness="1" BorderBrush="#4D7AABF1"
                        Background="#387547B7" MouseLeftButtonUp="OnJoin">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource VideoIcon}" Stroke="#A8CCFF" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" />
                        <TextBlock Text="Подключиться" FontSize="12" FontWeight="SemiBold" Foreground="#A8CCFF" Margin="7,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" x:Name="SearchBar" Margin="16,12,16,0" Visibility="Collapsed">
            <ui:TextBox x:Name="SearchBox" PlaceholderText="Название, участники, отправитель"
                        FontSize="12.5" TextChanged="OnSearchChanged" />
        </Border>

        <StackPanel Grid.Row="3" x:Name="FilterTabs" Orientation="Horizontal" Margin="14,14,14,10">
            <Border x:Name="TabAll" Style="{StaticResource IconButton}" Width="Auto" Height="Auto" CornerRadius="8"
                    Padding="10,7" Tag="all" MouseLeftButtonUp="OnFilterClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Все" FontSize="12" />
                    <TextBlock x:Name="CountAll" FontSize="10" Margin="7,1,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="TabMeetings" Style="{StaticResource IconButton}" Width="Auto" Height="Auto" CornerRadius="8"
                    Padding="10,7" Tag="meetings" MouseLeftButtonUp="OnFilterClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Встречи" FontSize="12" />
                    <TextBlock x:Name="CountMeetings" FontSize="10" Margin="7,1,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="TabMail" Style="{StaticResource IconButton}" Width="Auto" Height="Auto" CornerRadius="8"
                    Padding="10,7" Tag="mail" MouseLeftButtonUp="OnFilterClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Письма" FontSize="12" />
                    <TextBlock x:Name="CountMail" FontSize="10" Margin="7,1,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="TabUnread" Style="{StaticResource IconButton}" Width="Auto" Height="Auto" CornerRadius="8"
                    Padding="10,7" Tag="unread" MouseLeftButtonUp="OnFilterClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Непрочитанные" FontSize="12" />
                    <TextBlock x:Name="CountUnread" FontSize="10" Margin="7,1,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="4" Margin="16,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <ItemsControl x:Name="StreamList" Margin="0,0,11,10">
                    <ItemsControl.ItemTemplateSelector>
                        <views:StreamTemplateSelector
                            SectionTemplate="{StaticResource SectionTemplate}"
                            EventTemplate="{StaticResource EventTemplate}" />
                    </ItemsControl.ItemTemplateSelector>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" FontSize="12" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="5" Margin="16,0,16,0">
            <Border Height="1" Background="{StaticResource Hairline}" VerticalAlignment="Top" />
            <Grid Margin="0,11,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                    <Path Data="{StaticResource CheckIcon}" Stroke="#7893AD" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="13" Height="13"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Подключение…" FontSize="10" Foreground="#7893AD"
                               Margin="6,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="FooterText" FontSize="10" Foreground="#697284"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <Border x:Name="DetailPanel" Grid.RowSpan="6" Background="#101217" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,13,16,13">
                    <StackPanel Orientation="Horizontal" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnCloseDetail">
                        <Path Data="{StaticResource ChevronLeft}" Stroke="#8F96A6" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="15" Height="15"
                              VerticalAlignment="Center" />
                        <TextBlock Text="К списку" FontSize="12" Foreground="#8F96A6" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Style="{StaticResource IconButton}" HorizontalAlignment="Right" MouseLeftButtonUp="OnCloseDetail">
                        <Path Data="{StaticResource CloseIcon}" Stroke="#8F96A6" StrokeThickness="2"
                              StrokeStartLineCap="Round" Stretch="Uniform" Width="14" Height="14" />
                    </Border>
                </Grid>

                <Border Grid.Row="0" Height="1" Background="{StaticResource Hairline}" VerticalAlignment="Bottom" />

                <StackPanel Grid.Row="1" Margin="16,16,16,0">
                    <TextBlock x:Name="DetailWhen" Style="{StaticResource Caption}" Foreground="#EFB06C" />
                    <TextBlock x:Name="DetailSubject" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Fg}"
                               TextWrapping="Wrap" Margin="0,11,0,0" />
                    <TextBlock x:Name="DetailTime" FontSize="12" Foreground="#99A4B6" Margin="0,9,0,0" />
                    <TextBlock x:Name="DetailOrganizer" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,7,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <Border x:Name="DetailJoinPanel" Margin="0,14,0,0" Padding="13,11" CornerRadius="11"
                            BorderThickness="1" BorderBrush="#3D7AABF1" Background="#247547B7" Visibility="Collapsed">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,110,0">
                                <TextBlock x:Name="DetailPlatform" FontSize="12.5" FontWeight="SemiBold" Foreground="#CFE0FB" />
                                <TextBlock x:Name="DetailLink" FontSize="10.5" Foreground="#8194AD" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border CornerRadius="9" Padding="13,8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Cursor="Hand" BorderThickness="1" BorderBrush="#737AABF1" Background="#577547B7"
                                    MouseLeftButtonUp="OnJoinDetail">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VideoIcon}" Stroke="#DBE9FF" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                                          Width="14" Height="14" />
                                    <TextBlock Text="Подключиться" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#DBE9FF" Margin="7,0,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" x:Name="DetailAttendees" Margin="16,16,16,0" Padding="13,12" CornerRadius="11"
                        BorderThickness="1" BorderBrush="{StaticResource Hairline}" Background="#B8191C24"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="DetailAttendeeCount" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#DFE4ED" VerticalAlignment="Center" />
                            <StackPanel x:Name="DetailAttendeeToggle" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnToggleAttendees">
                                <TextBlock x:Name="DetailAttendeeToggleText" Text="Показать" FontSize="11" Foreground="#8F9BB0"
                                           VerticalAlignment="Center" />
                                <Path Data="M6,9 L12,15 L18,9" Stroke="#8F9BB0" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                                      Width="13" Height="13" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="DetailAttendeeSplit" FontSize="10.5" Foreground="{StaticResource Faint}" Margin="0,11,0,0" />
                        <ScrollViewer x:Name="DetailAttendeeList" MaxHeight="150" Margin="0,10,0,0"
                                      VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <ItemsControl x:Name="AttendeeItems" Margin="0,0,11,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="#B9C1CF"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                                            <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{StaticResource Faint}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="DetailAttendeeNote" FontSize="10" Foreground="#5F6878" Margin="0,9,0,0"
                                   TextWrapping="Wrap"
                                   Text="Кто принял приглашение, видит только организатор — Exchange не отдаёт чужие ответы." />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="3" Margin="16,15,10,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,10">
                        <TextBlock Text="ПОВЕСТКА" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="DetailBody" FontSize="12.5" Foreground="#B9C1CF" TextWrapping="Wrap"
                                   LineHeight="20" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="4" x:Name="DetailRsvp" Padding="16,13" Background="#E6101217" Visibility="Collapsed">
                    <StackPanel>
                        <Border Height="1" Background="{StaticResource Hairline}" Margin="0,-13,0,12" />
                        <TextBlock x:Name="DetailRsvpLabel" Text="Вы ещё не ответили на приглашение" FontSize="10"
                                   Foreground="#7B8496" Margin="0,0,0,9" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,4,0" CornerRadius="9" Padding="6,9" Cursor="Hand"
                                    BorderThickness="1" BorderBrush="#5965D6A0" Background="#2165D6A0"
                                    Tag="accept" MouseLeftButtonUp="OnRsvp">
                                <TextBlock Text="Принять" FontSize="12" FontWeight="SemiBold" Foreground="#8FE3BD"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Margin="4,0" CornerRadius="9" Padding="6,9" Cursor="Hand"
                                    BorderThickness="1" BorderBrush="#52EFB06C" Background="Transparent"
                                    Tag="tentative" MouseLeftButtonUp="OnRsvp">
                                <TextBlock Text="Под вопросом" FontSize="12" FontWeight="SemiBold" Foreground="#EFB06C"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="2" Margin="4,0,0,0" CornerRadius="9" Padding="6,9" Cursor="Hand"
                                    BorderThickness="1" BorderBrush="#52EE96AB" Background="Transparent"
                                    Tag="decline" MouseLeftButtonUp="OnRsvp">
                                <TextBlock Text="Отклонить" FontSize="12" FontWeight="SemiBold" Foreground="#EE96AB"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>