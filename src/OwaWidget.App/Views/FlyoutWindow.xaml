<ui:FluentWindow x:Class="OwaWidget.App.Views.FlyoutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:OwaWidget.App.Views"
                 Title="Owl"
                 Width="430"
                 Height="720"
                 WindowStyle="None"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="#F3F2F2"
                 Foreground="#201E1D"
                 FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"
                 UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#201E1D" />
        <SolidColorBrush x:Key="Secondary" Color="#57524F" />
        <SolidColorBrush x:Key="Tertiary" Color="#6F6A67" />
        <SolidColorBrush x:Key="Faint" Color="#8A8481" />
        <SolidColorBrush x:Key="Line" Color="#CFCAC6" />
        <SolidColorBrush x:Key="Divider" Color="#E0DCD9" />
        <SolidColorBrush x:Key="Surface" Color="#F3F2F2" />
        <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#EC3013" />
        <SolidColorBrush x:Key="AccentDeep" Color="#B81F05" />

        <Geometry x:Key="VideoIcon">M1.5,4.5 L11.5,4.5 L11.5,13.5 L1.5,13.5 Z M11.5,8.5 L16.5,6 L16.5,13 L11.5,10.5 Z</Geometry>
        <Geometry x:Key="PeopleIcon">M6.5,3.5 A2.5,2.5 0 1 1 6.49,3.5 Z M2,14.5 C2,11.5 4,10.2 6.5,10.2 C9,10.2 11,11.5 11,14.5 M12.2,4.2 A2.1,2.1 0 1 1 12.19,4.2 Z M12.6,10.4 C14.6,10.7 16,11.9 16,14.5</Geometry>
        <Geometry x:Key="ChevronRight">M7,3 L13,9 L7,15</Geometry>
        <Geometry x:Key="ChevronLeft">M11,3 L5,9 L11,15</Geometry>
        <Geometry x:Key="MailIcon">M1.5,4 L16.5,4 L16.5,14 L1.5,14 Z M2,4.6 L9,9.8 L16,4.6</Geometry>
        <Geometry x:Key="SearchIcon">M8,2.5 A5.5,5.5 0 1 1 7.99,2.5 Z M12,12 L16,16</Geometry>
        <Geometry x:Key="CopyIcon">M6,6 L15,6 L15,15 L6,15 Z M12,3 L3,3 L3,12</Geometry>
        <Geometry x:Key="ChevronDown">M4,6.5 L9,11.5 L14,6.5</Geometry>
        <Geometry x:Key="CloseIcon">M4,4 L14,14 M14,4 L4,14</Geometry>
        <Geometry x:Key="ClockIcon">M9,2.5 A6.5,6.5 0 1 1 8.99,2.5 Z M9,5.2 L9,9.2 L11.8,10.8</Geometry>

        <Style x:Key="SelectableBody" TargetType="FlowDocumentScrollViewer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsToolBarVisible" Value="False" />
            <Setter Property="IsSelectionEnabled" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionOpacity" Value="0.22" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="BareInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionOpacity" Value="0.22" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                                      Margin="0" Padding="0" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBox" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F2F2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="Bar" Width="2" CornerRadius="2"
                                                            HorizontalAlignment="Center">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="#CFCAC6" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Bar"
                                                                                     Storyboard.TargetProperty="Width"
                                                                                     To="4" Duration="0:0:0.1" />
                                                                    <ColorAnimation Storyboard.TargetName="Bar"
                                                                                    Storyboard.TargetProperty="Background.Color"
                                                                                    To="#8A8481" Duration="0:0:0.1" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="Bar"
                                                                                     Storyboard.TargetProperty="Width"
                                                                                     To="2" Duration="0:0:0.1" />
                                                                    <ColorAnimation Storyboard.TargetName="Bar"
                                                                                    Storyboard.TargetProperty="Background.Color"
                                                                                    To="#CFCAC6" Duration="0:0:0.1" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bar" Property="Width" Value="4" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                             Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"
                                                 BeginTime="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="SectionTemplate">
            <Grid Margin="0,11,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                           Foreground="{Binding LabelBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="1" Background="{StaticResource Line}" Margin="8,0,8,0"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11"
                           Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" SnapsToDevicePixels="True">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#CFCAC6" />
                            </Border.BorderBrush>
                            <Grid>
                                <Border x:Name="Tint" Background="#FDF1EE" CornerRadius="8" Opacity="0" />
                                <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" CornerRadius="2,0,0,2"
                                        Background="#EC3013" Opacity="0" />
                                <ContentPresenter x:Name="Body" Margin="12,9,12,10" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tint"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Bar"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="0:0:0.12" />
                                            <ColorAnimation Storyboard.TargetName="Shell"
                                                            Storyboard.TargetProperty="BorderBrush.Color"
                                                            To="#E9B3A6" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tint"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Bar"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="0:0:0.12" />
                                            <ColorAnimation Storyboard.TargetName="Shell"
                                                            Storyboard.TargetProperty="BorderBrush.Color"
                                                            To="#CFCAC6" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tint" Property="Background" Value="#FBE2DB" />
                                <Setter TargetName="Body" Property="Margin" Value="12,10,12,9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MailRowButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="8" Margin="0,0,0,2" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Tint" Background="#FDF1EE" CornerRadius="8" Opacity="0" />
                                <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" CornerRadius="2,0,0,2"
                                        Background="#EC3013" Opacity="0" />
                                <ContentPresenter x:Name="Body" Margin="8,7,10,7" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tint"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Bar"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tint"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Bar"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tint" Property="Background" Value="#FBE2DB" />
                                <Setter TargetName="Body" Property="Margin" Value="8,8,10,6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MeetingTemplate">
            <Button Style="{StaticResource RowButton}" Click="OnMeetingClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TimeColumn}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,14,0"
                               Visibility="{Binding TimeColumnVisibility}" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock views:Highlight.Text="{Binding Title}" views:Highlight.Words="{Binding Words}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{Binding TitleBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{Binding MetaBrush}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource IconBox}" Visibility="{Binding JoinVisibility}"
                            VerticalAlignment="Center" MouseLeftButtonUp="OnJoinMeeting">
                        <Path Data="{StaticResource VideoIcon}" Stroke="{StaticResource Ink}" StrokeThickness="1.6"
                              StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="LeftChip" TargetType="Border">
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FDF1EE" />
                    <Setter Property="BorderBrush" Value="#E9B3A6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RecentQueryTemplate">
            <Border Style="{StaticResource LeftChip}" MouseLeftButtonUp="OnUseQuery">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource ClockIcon}" Stroke="{StaticResource Faint}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" Stretch="Uniform" Width="13" Height="13"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Ink}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SuggestQueryTemplate">
            <Border Style="{StaticResource LeftChip}" MouseLeftButtonUp="OnUseQuery">
                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Ink}"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MailSectionTemplate">
            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Secondary}"
                       Margin="18,8,18,4" />
        </DataTemplate>

        <Style x:Key="MailListButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Divider}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Tint" Background="#FDF1EE" Opacity="0" />
                                <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" Background="#EC3013"
                                        Opacity="0" />
                                <ContentPresenter x:Name="Body" Margin="18,9,26,9" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tint"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Bar"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tint"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Bar"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tint" Property="Background" Value="#FBE2DB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MailListTemplate">
            <Button Style="{StaticResource MailListButton}" Click="OnLetterClick"
                    Background="{Binding RowBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource Accent}"
                             VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0"
                             Visibility="{Binding DotVisibility}" />
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,46,0">
                                <TextBlock Text="{Binding Sender}" FontSize="{Binding SenderSize}"
                                           FontWeight="{Binding SenderWeight}" Foreground="{Binding SenderBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SenderNote}" FontSize="11" Foreground="{StaticResource Tertiary}"
                                           VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource Secondary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Subject}" FontSize="{Binding SubjectSize}"
                                   FontWeight="{Binding SubjectWeight}" Foreground="{Binding SubjectBrush}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{StaticResource Secondary}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding PreviewVisibility}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,2"
                                    Visibility="{Binding InvitationVisibility}">
                            <Border Height="28" Padding="12,0" CornerRadius="8" Background="{StaticResource Accent}"
                                    Cursor="Hand" Tag="accept" MouseLeftButtonUp="OnInvitationReply">
                                <TextBlock Text="Принять" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border Height="28" Padding="12,0" CornerRadius="8" Margin="6,0,0,0"
                                    Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" Cursor="Hand" Tag="tentative"
                                    MouseLeftButtonUp="OnInvitationReply">
                                <TextBlock Text="Под вопросом" FontSize="12" Foreground="{StaticResource Ink}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border Height="28" Padding="12,0" CornerRadius="8" Margin="6,0,0,0"
                                    Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" Cursor="Hand" Tag="decline"
                                    MouseLeftButtonUp="OnInvitationReply">
                                <TextBlock Text="Отклонить" FontSize="12" Foreground="{StaticResource Ink}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="MailTemplate">
            <Button Style="{StaticResource MailRowButton}" Click="OnMailClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource Accent}"
                             VerticalAlignment="Center" Visibility="{Binding DotVisibility}" />
                    <TextBlock Grid.Column="1" views:Highlight.Text="{Binding Line}"
                               views:Highlight.Words="{Binding Words}" FontSize="13" Margin="10,0,10,0"
                               Foreground="{Binding LineBrush}" FontWeight="{Binding LineWeight}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="11"
                               Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0">
                <Grid x:Name="HeaderIdle">
                    <TextBlock x:Name="BrandText" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" FontSize="12" Foreground="{StaticResource Secondary}"
                                   VerticalAlignment="Center" />
                        <Border x:Name="SearchToggle" Style="{StaticResource IconBox}" Width="28" Height="28"
                                Margin="12,0,0,0" Background="Transparent" BorderThickness="0"
                                MouseLeftButtonUp="OnToggleSearch" ToolTip="Поиск">
                            <Path Data="{StaticResource SearchIcon}" Stroke="{StaticResource Secondary}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="15" Height="15" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SearchRow" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SearchShift" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="32" CornerRadius="8" Background="{StaticResource Card}"
                            BorderBrush="{StaticResource Accent}" BorderThickness="1">
                        <Grid Margin="10,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource SearchIcon}" Stroke="{StaticResource Faint}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="13" Height="13"
                                  VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Margin="9,0,8,0">
                                <TextBlock x:Name="SearchPlaceholder" Text="Тема, участник, отправитель"
                                           FontSize="13" Foreground="{StaticResource Faint}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="SearchBox" Style="{StaticResource BareInput}"
                                         TextChanged="OnSearchChanged" KeyDown="OnSearchKey" />
                            </Grid>
                            <TextBlock x:Name="SearchCount" Grid.Column="2" FontSize="12"
                                       Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource IconBox}" Width="28" Height="28"
                            Margin="10,0,0,0" Background="Transparent" BorderThickness="0"
                            MouseLeftButtonUp="OnCloseSearch" ToolTip="Закрыть поиск">
                        <Path Data="{StaticResource CloseIcon}" Stroke="{StaticResource Secondary}"
                              StrokeThickness="1.6" Stretch="Uniform" Width="13" Height="13" />
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="1" x:Name="OfflineBar" Margin="22,0,22,10" Padding="12,9" CornerRadius="8"
                    Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="OfflineTitle" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="OfflineDetail" FontSize="11" Foreground="{StaticResource Secondary}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" x:Name="HeroCard" Margin="22,0,22,0" Padding="18,13,18,14" CornerRadius="10"
                    Background="{StaticResource Card}" BorderThickness="0,2,0,0"
                    BorderBrush="{StaticResource Accent}" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="HeroLabel" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AccentDeep}" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeroMeta" FontSize="12" Foreground="{StaticResource Secondary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="HeroCountdown" FontSize="34" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="HeroUnit" FontSize="20" Foreground="{StaticResource Secondary}"
                                   VerticalAlignment="Bottom" Margin="6,0,0,3" />
                    </StackPanel>
                    <TextBlock x:Name="HeroSubject" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                               TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0" MaxHeight="46" />
                    <Grid x:Name="HeroButtons" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HeroJoinColumn" Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="HeroJoin" Height="40" CornerRadius="8"
                                Background="{StaticResource Accent}" Cursor="Hand" MouseLeftButtonUp="OnJoinHero">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                <Path Data="{StaticResource VideoIcon}" Stroke="White" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="18" />
                                <TextBlock Text="Подключиться" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                           Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource IconBox}" Width="40" Height="40"
                                Margin="8,0,0,0" MouseLeftButtonUp="OnOpenHeroDetail" ToolTip="Участники">
                            <Path Data="{StaticResource PeopleIcon}" Stroke="{StaticResource Ink}" StrokeThickness="1.6"
                                  Stretch="Uniform" Width="18" Height="18" />
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource IconBox}" Width="40" Height="40"
                                Margin="8,0,0,0" MouseLeftButtonUp="OnOpenHeroDetail" ToolTip="Открыть встречу">
                            <Path Data="{StaticResource ChevronRight}" Stroke="{StaticResource Ink}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" x:Name="CalmCard" Margin="22,0,22,0" Padding="18,15,18,16" CornerRadius="10"
                    Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="CalmLabel" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CalmNote" FontSize="12" Foreground="{StaticResource Faint}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="CalmTitle" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                               Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="27" />
                    <TextBlock x:Name="CalmDetail" FontSize="13" Foreground="{StaticResource Secondary}"
                               Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    <Border x:Name="CalmButton" Margin="0,14,0,0" Padding="13,0" Height="36" CornerRadius="8"
                            HorizontalAlignment="Left" Background="{StaticResource Card}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="OnJumpToNextDay">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M2.5,3.5 L15.5,3.5 L15.5,15.5 L2.5,15.5 Z M2.5,7 L15.5,7 M6,1.8 L6,5 M12,1.8 L12,5"
                                  Stroke="{StaticResource Ink}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock x:Name="CalmButtonText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" x:Name="SearchTools" Margin="22,0,22,0" Visibility="Collapsed">
                <TextBlock x:Name="FiltersLabel" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Secondary}" Margin="0,0,0,7" />
                <WrapPanel>
                    <Border x:Name="FilterToday" Style="{StaticResource LeftChip}" Tag="today"
                            MouseLeftButtonUp="OnSearchFilter">
                        <TextBlock x:Name="FilterTodayText" Text="Сегодня" FontSize="12" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="FilterWeek" Style="{StaticResource LeftChip}" Tag="week"
                            MouseLeftButtonUp="OnSearchFilter">
                        <TextBlock x:Name="FilterWeekText" Text="Эта неделя" FontSize="12" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="FilterOpen" Style="{StaticResource LeftChip}" Tag="unanswered"
                            MouseLeftButtonUp="OnSearchFilter">
                        <TextBlock x:Name="FilterOpenText" Text="Вы не ответили" FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>
                </WrapPanel>

                <StackPanel x:Name="SearchIdle">
                    <StackPanel x:Name="RecentBlock">
                        <TextBlock x:Name="RecentLabel" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Secondary}" Margin="0,9,0,7" />
                        <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource RecentQueryTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock x:Name="SearchScope" FontSize="12" Foreground="{StaticResource Tertiary}"
                               TextWrapping="Wrap" LineHeight="17" Margin="0,5,0,0" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="3" Margin="22,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <ItemsControl x:Name="StreamList" Margin="0,0,10,12">
                        <ItemsControl.ItemTemplateSelector>
                            <views:StreamTemplateSelector
                                SectionTemplate="{StaticResource SectionTemplate}"
                                MeetingTemplate="{StaticResource MeetingTemplate}"
                                MailTemplate="{StaticResource MailTemplate}" />
                        </ItemsControl.ItemTemplateSelector>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyBlock" VerticalAlignment="Top" Visibility="Collapsed" Margin="0,2,10,0">
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14,16,16">
                        <StackPanel>
                            <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                            <TextBlock x:Name="EmptyDetail" FontSize="13" Foreground="{StaticResource Secondary}"
                                       TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="19" />
                            <Border x:Name="EmptyClear" Height="32" Padding="13,0" CornerRadius="8"
                                    HorizontalAlignment="Left" Margin="0,14,0,0" Background="{StaticResource Card}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1" Cursor="Hand"
                                    Visibility="Collapsed" MouseLeftButtonUp="OnClearSearch">
                                <TextBlock Text="Очистить" FontSize="12" Foreground="{StaticResource Ink}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SuggestBlock" Visibility="Collapsed">
                        <TextBlock x:Name="SuggestLabel" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Secondary}" Margin="2,15,0,7" />
                        <ItemsControl x:Name="SuggestList" ItemTemplate="{StaticResource SuggestQueryTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="4" x:Name="SearchFooter" Background="#E9E6E3" BorderBrush="{StaticResource Ink}"
                    BorderThickness="0,2,0,0" Padding="22,11,22,12" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="SearchTally" FontSize="12" Foreground="{StaticResource Ink}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <TextBlock Text="Esc — закрыть поиск" FontSize="11" Foreground="{StaticResource Secondary}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="4" x:Name="MailFooter" Background="#E9E6E3" BorderBrush="{StaticResource Ink}"
                    BorderThickness="0,2,0,0"
                    Padding="22,11,22,12" Cursor="Hand" MouseLeftButtonUp="OnOpenMailPanel">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="MailLabel" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="MailSummary" FontSize="12" Foreground="{StaticResource Secondary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl x:Name="MailPeek" Margin="0,7,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource Accent}"
                                             VerticalAlignment="Center" Visibility="{Binding DotVisibility}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Line}" FontSize="13" Margin="9,0,0,0"
                                               Foreground="{Binding LineBrush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Padding="22,0">
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource Secondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Border>

            <Border x:Name="DetailPanel" Grid.RowSpan="6" Background="{StaticResource Surface}"
                    CornerRadius="8" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="22,0">
                        <StackPanel Orientation="Horizontal" Cursor="Hand" Background="Transparent"
                                    MouseLeftButtonUp="OnCloseDetail" VerticalAlignment="Center">
                            <Path Data="{StaticResource ChevronLeft}" Stroke="{StaticResource Ink}" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="Встреча" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="DetailRecurrence" FontSize="12" Foreground="{StaticResource Secondary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Row="0" Height="1" Background="{StaticResource Line}" VerticalAlignment="Bottom" />

                    <StackPanel Grid.Row="1" Margin="22,16,22,0">
                        <TextBlock x:Name="DetailWhen" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AccentDeep}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailSubject" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                   TextWrapping="Wrap" LineHeight="24" Margin="0,10,0,0" />
                        <TextBlock x:Name="DetailOrganizer" FontSize="13" Foreground="{StaticResource Secondary}"
                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                        <Grid x:Name="DetailJoinRow" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="40" CornerRadius="8" Background="{StaticResource Accent}"
                                    Cursor="Hand" MouseLeftButtonUp="OnJoinDetail">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                    <Path Data="{StaticResource VideoIcon}" Stroke="White" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="18" />
                                    <TextBlock Text="Подключиться" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                               Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource IconBox}" Width="40" Height="40"
                                    Margin="8,0,0,0" MouseLeftButtonUp="OnCopyLink" ToolTip="Скопировать ссылку">
                                <Path Data="{StaticResource CopyIcon}" Stroke="{StaticResource Ink}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="DetailLink" FontSize="11" Foreground="{StaticResource Faint}"
                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Row="2" x:Name="DetailAttendees" Margin="22,16,22,0" Padding="12,10,12,11"
                            CornerRadius="8" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnToggleAttendees">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource PeopleIcon}" Stroke="{StaticResource Ink}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16"
                                          VerticalAlignment="Center" />
                                    <TextBlock x:Name="DetailAttendeeCount" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailAttendeeToggle" Text="Показать" FontSize="12"
                                               Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                                    <Path Data="{StaticResource ChevronDown}" Stroke="{StaticResource Secondary}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform"
                                          Width="13" Height="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="DetailAttendeeSplit" FontSize="12" Foreground="{StaticResource Secondary}"
                                       Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="DetailAttendeeList" MaxHeight="180" Margin="0,9,0,0"
                                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <ItemsControl x:Name="AttendeeItems" Margin="0,0,11,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Ink}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,110,0" />
                                                <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource Faint}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="DetailAttendeeNote" FontSize="11" Foreground="{StaticResource Faint}"
                                       Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="16"
                                       Text="Кто принял приглашение, видит только организатор — Exchange не отдаёт чужие ответы." />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3" Margin="22,16,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="DetailAgendaLabel" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Secondary}" Margin="0,0,10,9" />
                        <FlowDocumentScrollViewer Grid.Row="1" x:Name="DetailBodyView"
                                                  Style="{StaticResource SelectableBody}" />
                    </Grid>

                    <Border Grid.Row="4" x:Name="DetailRsvp" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                            Padding="22,11,22,13" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DetailRsvpLabel" FontSize="11" Foreground="{StaticResource Secondary}"
                                       Margin="0,0,0,9" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" x:Name="RsvpAccept" Margin="0,0,4,0" Height="34" CornerRadius="8"
                                        Background="{StaticResource Accent}" Cursor="Hand" Tag="accept"
                                        MouseLeftButtonUp="OnRsvp">
                                    <TextBlock Text="Принять" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" x:Name="RsvpTentative" Margin="4,0" Height="34" CornerRadius="8"
                                        Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" Cursor="Hand" Tag="tentative" MouseLeftButtonUp="OnRsvp">
                                    <TextBlock Text="Под вопросом" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2" x:Name="RsvpDecline" Margin="4,0,0,0" Height="34" CornerRadius="8"
                                        Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" Cursor="Hand" Tag="decline" MouseLeftButtonUp="OnRsvp">
                                    <TextBlock Text="Отклонить" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="MailPanel" Grid.RowSpan="6" Background="{StaticResource Surface}"
                    CornerRadius="8" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,0">
                        <StackPanel Orientation="Horizontal" Cursor="Hand" Background="Transparent"
                                    MouseLeftButtonUp="OnCloseMailPanel" VerticalAlignment="Center">
                            <Path Data="{StaticResource ChevronLeft}" Stroke="{StaticResource Ink}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Почта" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border x:Name="ChipUnread" Style="{StaticResource Chip}" Tag="unread"
                                    MouseLeftButtonUp="OnMailFilter">
                                <TextBlock x:Name="ChipUnreadText" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ChipAll" Style="{StaticResource Chip}" Tag="all"
                                    MouseLeftButtonUp="OnMailFilter">
                                <TextBlock x:Name="ChipAllText" FontSize="12" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ChipPeople" Style="{StaticResource Chip}" Tag="people"
                                    MouseLeftButtonUp="OnMailFilter">
                                <TextBlock x:Name="ChipPeopleText" Text="люди" FontSize="12" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="0" Height="1" Background="{StaticResource Line}" VerticalAlignment="Bottom" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl x:Name="MailList">
                            <ItemsControl.ItemTemplateSelector>
                                <views:StreamTemplateSelector
                                    SectionTemplate="{StaticResource MailSectionTemplate}"
                                    MailListTemplate="{StaticResource MailListTemplate}" />
                            </ItemsControl.ItemTemplateSelector>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0"
                            Background="#E9E6E3" Padding="18,11,18,12">
                        <Grid>
                            <Border x:Name="MarkAllButton" Height="32" Padding="12,0" CornerRadius="8"
                                    HorizontalAlignment="Left" Background="{StaticResource Card}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonUp="OnMarkAllRead">
                                <TextBlock Text="Отметить все прочитанными" FontSize="12"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="MailRobotsText" FontSize="12" Foreground="{StaticResource Secondary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="LetterPanel" Grid.RowSpan="6" Background="{StaticResource Surface}"
                    CornerRadius="8" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,0">
                        <StackPanel Orientation="Horizontal" Cursor="Hand" Background="Transparent"
                                    MouseLeftButtonUp="OnCloseLetter" VerticalAlignment="Center">
                            <Path Data="{StaticResource ChevronLeft}" Stroke="{StaticResource Ink}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Письмо" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="LetterPosition" FontSize="12" Foreground="{StaticResource Secondary}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Style="{StaticResource IconBox}" Width="26" Height="26" Margin="0"
                                    MouseLeftButtonUp="OnLetterPrev" ToolTip="Предыдущее">
                                <Path Data="{StaticResource ChevronLeft}" Stroke="{StaticResource Ink}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" />
                            </Border>
                            <Border Style="{StaticResource IconBox}" Width="26" Height="26" Margin="6,0,0,0"
                                    MouseLeftButtonUp="OnLetterNext" ToolTip="Следующее">
                                <Path Data="{StaticResource ChevronRight}" Stroke="{StaticResource Ink}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="0" Height="1" Background="{StaticResource Line}" VerticalAlignment="Bottom" />

                    <Border Grid.Row="1" Background="{StaticResource Card}" Padding="18,14"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock x:Name="LetterSubject" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextWrapping="Wrap" LineHeight="23" />
                            <Grid Margin="0,10,0,0">
                                <StackPanel Margin="0,0,70,0">
                                    <TextBlock x:Name="LetterFrom" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="LetterTo" FontSize="12" Foreground="{StaticResource Secondary}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="LetterDate" FontSize="12" Foreground="{StaticResource Secondary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <FlowDocumentScrollViewer Grid.Row="2" x:Name="LetterBodyView" Margin="18,14,10,0"
                                              Style="{StaticResource SelectableBody}" />

                    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                            Padding="18,11,18,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Height="36" Padding="14,0" CornerRadius="8" Background="{StaticResource Accent}"
                                    Cursor="Hand" MouseLeftButtonUp="OnOpenMail">
                                <TextBlock Text="Открыть в почте" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="LetterMarkRead" Height="36" Padding="14,0" CornerRadius="8" Margin="8,0,0,0"
                                    Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="OnLetterMarkRead">
                                <TextBlock x:Name="LetterMarkReadText" Text="Отметить прочитанным" FontSize="13"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>