<ui:FluentWindow x:Class="OwaWidget.App.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Подключение к почте"
                 Width="440"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Подключение к почте" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,12,24,24">
            <TextBlock Text="Корпоративная почта"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Пароль хранится в диспетчере учётных данных Windows и никуда больше не передаётся."
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       Margin="0,0,0,20" />

            <TextBlock Text="Сервер" Margin="0,0,0,4" />
            <ui:TextBox x:Name="ServerBox" Margin="0,0,0,14" />

            <TextBlock Text="Логин" Margin="0,0,0,4" />
            <ui:TextBox x:Name="UserBox" PlaceholderText="moscow\u_xxxxx" Margin="0,0,0,14" />

            <TextBlock Text="Пароль" Margin="0,0,0,4" />
            <ui:PasswordBox x:Name="PasswordBox" Margin="0,0,0,8" />

            <ui:InfoBar x:Name="ErrorBar"
                        Severity="Error"
                        IsOpen="False"
                        IsClosable="False"
                        Margin="0,0,0,12" />

            <TextBlock Text="Проверка делает одну попытку входа — при опечатке учётная запись не блокируется."
                       TextWrapping="Wrap"
                       Opacity="0.6"
                       FontSize="12"
                       Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CancelButton"
                           Content="Отмена"
                           Click="OnCancel"
                           Margin="0,0,8,0"
                           MinWidth="100" />
                <ui:Button x:Name="ConnectButton"
                           Content="Подключиться"
                           Appearance="Primary"
                           Click="OnConnect"
                           MinWidth="140" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>