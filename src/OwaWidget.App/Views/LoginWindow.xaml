<ui:FluentWindow x:Class="OwaWidget.App.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Owl"
                 Width="440"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ResizeMode="NoResize"
                 Background="#F3F2F2"
                 Foreground="#201E1D"
                 FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"
                 UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#201E1D" />
        <SolidColorBrush x:Key="Secondary" Color="#57524F" />
        <SolidColorBrush x:Key="Tertiary" Color="#6F6A67" />
        <SolidColorBrush x:Key="Faint" Color="#8A8481" />
        <SolidColorBrush x:Key="Line" Color="#CFCAC6" />
        <SolidColorBrush x:Key="Divider" Color="#E0DCD9" />
        <SolidColorBrush x:Key="Surface" Color="#F3F2F2" />
        <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#EC3013" />
        <SolidColorBrush x:Key="AccentDeep" Color="#B81F05" />

        <Geometry x:Key="CloseIcon">M4,4 L14,14 M14,4 L4,14</Geometry>
        <Geometry x:Key="LockIcon">M5.6,8 L5.6,5.6 A3.4,3.4 0 0 1 12.4,5.6 L12.4,8 M3.6,8 L14.4,8 L14.4,15.4 L3.6,15.4 Z</Geometry>
        <Geometry x:Key="EyeIcon">M1.6,9 C4.4,4.8 13.6,4.8 16.4,9 C13.6,13.2 4.4,13.2 1.6,9 Z M9,6.9 A2.1,2.1 0 1 1 8.99,6.9 Z</Geometry>
        <Geometry x:Key="EyeOffIcon">M1.6,9 C4.4,4.8 13.6,4.8 16.4,9 C13.6,13.2 4.4,13.2 1.6,9 Z M9,6.9 A2.1,2.1 0 1 1 8.99,6.9 Z M3,15.4 L15,2.6</Geometry>
        <Geometry x:Key="AlertIcon">M9,2.6 A6.4,6.4 0 1 1 8.99,2.6 Z M9,5.4 L9,9.8 M9,12 L9,12.6</Geometry>
        <Geometry x:Key="InfoIcon">M9,2.6 A6.4,6.4 0 1 1 8.99,2.6 Z M9,8.2 L9,12.6 M9,5.4 L9,6</Geometry>
        <Geometry x:Key="DoneIcon">M9,2.6 A6.4,6.4 0 1 1 8.99,2.6 Z M5.8,9.1 L8,11.3 L12.2,7.1</Geometry>
        <Geometry x:Key="WarnIcon">M9,2.8 L16.4,15.4 L1.6,15.4 Z M9,7 L9,10.6 M9,12.6 L9,13.2</Geometry>

        <Style x:Key="BareInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionOpacity" Value="0.22" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                                      Margin="0" Padding="0" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarePassword" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionOpacity" Value="0.22" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                                      Margin="0" Padding="0" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Secondary}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Focus" CornerRadius="10" BorderThickness="2" Margin="-4"
                                    BorderBrush="{StaticResource Accent}" Opacity="0" />
                            <Border x:Name="Shell" CornerRadius="8" SnapsToDevicePixels="True">
                                <Border.Background>
                                    <SolidColorBrush Color="#EC3013" />
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="16,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Shell"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#B81F05" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Shell"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#EC3013" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Focus" CornerRadius="10" BorderThickness="2" Margin="-4"
                                    BorderBrush="{StaticResource Accent}" Opacity="0" />
                            <Border x:Name="Shell" CornerRadius="8" BorderThickness="1" SnapsToDevicePixels="True"
                                    Background="{StaticResource Card}">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#CFCAC6" />
                                </Border.BorderBrush>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="16,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Shell"
                                                            Storyboard.TargetProperty="BorderBrush.Color"
                                                            To="#E9B3A6" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Shell"
                                                            Storyboard.TargetProperty="BorderBrush.Color"
                                                            To="#CFCAC6" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FDF1EE" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="22,0" Background="Transparent" MouseLeftButtonDown="OnDragWindow">
            <TextBlock x:Name="BrandText" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink}"
                       VerticalAlignment="Center" />
            <Border Style="{StaticResource IconButton}" Width="28" Height="28" HorizontalAlignment="Right"
                    VerticalAlignment="Center" MouseLeftButtonUp="OnCancel" ToolTip="Закрыть">
                <Path Data="{StaticResource CloseIcon}" Stroke="{StaticResource Secondary}" StrokeThickness="1.6"
                      Stretch="Uniform" Width="13" Height="13" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Margin="22,0,22,18">
            <StackPanel Orientation="Horizontal">
                <Path x:Name="HeadingGlyph" Data="{StaticResource DoneIcon}" Stroke="{StaticResource Accent}"
                      StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="20" Height="20"
                      VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" />
                <TextBlock x:Name="HeadingText" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                           TextWrapping="Wrap" LineHeight="24" VerticalAlignment="Center" MaxWidth="366" />
            </StackPanel>

            <TextBlock x:Name="LeadText" FontSize="13" Foreground="{StaticResource Secondary}"
                       TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0" />

            <Border x:Name="AlertCard" CornerRadius="8" BorderThickness="1" Padding="13,11" Margin="0,14,0,0"
                    Background="#FDF1EE" BorderBrush="#E9B3A6" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="AlertGlyph" Grid.Column="0" Data="{StaticResource AlertIcon}"
                          Stroke="{StaticResource Accent}" StrokeThickness="1.5" StrokeLineJoin="Round"
                          Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                        <TextBlock x:Name="AlertTitle" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentDeep}" TextWrapping="Wrap" />
                        <TextBlock x:Name="AlertDetail" FontSize="12" Foreground="{StaticResource Secondary}"
                                   TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0" />
                        <TextBlock x:Name="AlertNote" FontSize="12" Foreground="{StaticResource Faint}"
                                   TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="TrustCard" CornerRadius="8" BorderThickness="1" Padding="13,11" Margin="0,14,0,0"
                    Background="{StaticResource Card}" BorderBrush="{StaticResource Line}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource LockIcon}" Stroke="{StaticResource Tertiary}"
                          StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16"
                          VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Margin="11,0,0,0" FontSize="12" LineHeight="17"
                               Foreground="{StaticResource Secondary}" TextWrapping="Wrap"
                               Text="Пароль хранится в диспетчере учётных данных Windows и никуда больше не передаётся." />
                </Grid>
            </Border>

            <StackPanel x:Name="FormBlock" Margin="0,16,0,0">
                <TextBlock Text="Сервер" Style="{StaticResource FieldLabel}" />
                <Border x:Name="ServerField" Style="{StaticResource FieldBox}">
                    <TextBox x:Name="ServerBox" Style="{StaticResource BareInput}" />
                </Border>

                <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <Border x:Name="UserField" Style="{StaticResource FieldBox}">
                    <Grid>
                        <TextBlock x:Name="UserHint" Text="домен\имя или имя@домен" FontSize="13"
                                   Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="UserBox" Style="{StaticResource BareInput}" />
                    </Grid>
                </Border>

                <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <Border x:Name="PasswordField" Style="{StaticResource FieldBox}" Padding="11,0,7,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock x:Name="PasswordHint" FontSize="13" Foreground="{StaticResource Faint}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource BarePassword}" />
                            <TextBox x:Name="PasswordPlain" Style="{StaticResource BareInput}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <Border Grid.Column="1" x:Name="RevealButton" Style="{StaticResource IconButton}"
                                MouseLeftButtonUp="OnToggleReveal" ToolTip="Показать пароль">
                            <Path x:Name="RevealGlyph" Data="{StaticResource EyeIcon}"
                                  Stroke="{StaticResource Tertiary}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="15" Height="15" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel x:Name="CapsWarning" Orientation="Horizontal" Margin="0,7,0,0" Visibility="Collapsed">
                    <Path Data="{StaticResource WarnIcon}" Stroke="{StaticResource AccentDeep}"
                          StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Включён Caps Lock — пароль вводится прописными" FontSize="12"
                               Foreground="{StaticResource AccentDeep}" Margin="7,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="DoneBlock" Visibility="Collapsed">
                <Border CornerRadius="8" BorderThickness="1" Padding="14,13" Margin="0,14,0,0"
                        Background="{StaticResource Card}" BorderBrush="{StaticResource Line}">
                    <StackPanel>
                        <TextBlock Text="Owl свернулся в трей. Значок слева от часов — нажмите на него, чтобы открыть окно."
                                   FontSize="13" LineHeight="19" Foreground="{StaticResource Ink}"
                                   TextWrapping="Wrap" />
                        <Border CornerRadius="6" Background="#E9E6E3" Padding="10,7" Margin="0,11,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="16" Height="16" CornerRadius="4"
                                        Background="{StaticResource Accent}" BorderBrush="{StaticResource Ink}"
                                        BorderThickness="2" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TrayClock" FontSize="11" Foreground="{StaticResource Secondary}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock x:Name="TrayDate" FontSize="11" Foreground="{StaticResource Secondary}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Так это выглядит на панели задач." FontSize="12"
                                   Foreground="{StaticResource Faint}" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Если значка не видно — раскройте скрытые значки стрелкой на панели задач и закрепите Owl."
                           FontSize="12" LineHeight="17" Foreground="{StaticResource Secondary}"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Background="#E9E6E3" BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0"
                Padding="22,13">
            <Grid>
                <TextBlock x:Name="BusyText" Text="Обычно занимает 2–5 секунд" FontSize="12"
                           Foreground="{StaticResource Secondary}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="150" HorizontalAlignment="Left"
                           Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Click="OnCancel"
                            IsCancel="True" Margin="0,0,10,0">
                        <TextBlock Text="Отмена" FontSize="13" Foreground="{StaticResource Ink}" />
                    </Button>
                    <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Click="OnConnect"
                            IsDefault="True">
                        <TextBlock x:Name="ConnectText" Text="Подключиться" FontSize="13" FontWeight="SemiBold"
                                   Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>